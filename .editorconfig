# Sjednocené kódování a formátování napříč editory.
# UTF-8 s BOM je u zdrojových souborů C# nutnost: bez BOM dekóduje kompilátor
# na Windows zdrojový kód systémovou ANSI kódovou stránkou a diakritika se rozbije.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
charset = utf-8-bom

# Všechna bezpečnostní pravidla analyzátorů .NET zapnutá jako chyby buildu – lokálně i v CI.
dotnet_analyzer_diagnostic.category-Security.severity = error

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

# Docker a nginx čtou tyto soubory po řádcích; LF a žádný BOM.
[{Dockerfile,Dockerfile.*,*.dockerignore,.dockerignore,compose.yaml,compose.*.yaml,*.conf,*.env}]
charset = utf-8
end_of_line = lf
indent_size = 2

# Shellové skripty spouští bash; s CRLF by nefungovaly.
[*.sh]
end_of_line = lf

[*.md]
end_of_line = lf
indent_size = 2
